<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!--
    MyBatis-Plus 核心配置文件（非 Spring 环境）

    说明：
    1. 本文件使用标准 MyBatis DTD，由 MyBatis-Plus 的 MybatisXMLConfigBuilder 解析
       （通过 new MybatisSqlSessionFactoryBuilder().build(in) 加载），
       因此 BaseMapper 的通用 CRUD 方法会被自动注入。
    2. globalConfig 等 MyBatis-Plus 扩展标签不会从 XML 中解析，
       所以 GlobalConfig（例如 MetaObjectHandler 自动填充处理器）需要通过
       GlobalConfigUtils 手动注入。
    3. 插件（分页、乐观锁、防全表更新/删除）在
       com.chaperMybatisPlus.config.MybatisPlusConfig 中注册；
       MetaObjectHandler 在 StudentTest.init() 中通过
       GlobalConfigUtils.setGlobalConfig() 注册。
    4. 老师的示例使用 resource="common/db.properties"；这里复用项目中已有的
       classpath 根目录下的 db.properties（与 mybatis-config.xml 共用），
       这样数据库账号密码只需维护一处。
-->
<configuration>

    <!-- 引入数据库连接配置（jdbc.driver / jdbc.url / jdbc.username / jdbc.password） -->
    <properties resource="db.properties"/>

    <settings>
        <!-- 使用 log4j 输出 SQL 日志 -->
        <setting name="logImpl" value="LOG4J"/>
        <!-- 下划线转驼峰：create_time -> createTime -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 关闭二级缓存，便于观察每次执行的 SQL -->
        <setting name="cacheEnabled" value="false"/>
    </settings>

    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${jdbc.driver}"/>
                <property name="url" value="${jdbc.url}"/>
                <property name="username" value="${jdbc.username}"/>
                <property name="password" value="${jdbc.password}"/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <!-- 扫描 Mapper 接口所在包（StudentMapper 继承 BaseMapper，无需 XML） -->
        <package name="com.chaperMybatisPlus.mapper"/>
    </mappers>

</configuration>
