<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.mapper.EmpMapper">

    <resultMap id="empMap" type="com.lab.entity.Emp">
        <id     property="empId"    column="emp_id"/>
        <result property="empName"  column="emp_name"/>
        <result property="gender"   column="gender"/>
        <result property="dept"     column="dept"/>
        <result property="post"     column="post"/>
        <result property="salary"   column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status"   column="status"/>
    </resultMap>

    <sql id="allColumns">
        emp_id, emp_name, gender, dept, post, salary, hire_date, status
    </sql>

    <select id="selectAll" resultMap="empMap">
        SELECT <include refid="allColumns"/>
        FROM emp
        ORDER BY emp_id
    </select>

    <select id="selectById" resultMap="empMap" parameterType="int">
        SELECT <include refid="allColumns"/>
        FROM emp
        WHERE emp_id = #{empId}
    </select>

    <insert id="insert" parameterType="com.lab.entity.Emp"
            useGeneratedKeys="true" keyProperty="empId" keyColumn="emp_id">
        INSERT INTO emp (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES (#{empName}, #{gender}, #{dept}, #{post}, #{salary}, #{hireDate}, #{status})
    </insert>

    <update id="update" parameterType="com.lab.entity.Emp">
        UPDATE emp
        SET emp_name  = #{empName},
            gender    = #{gender},
            dept      = #{dept},
            post      = #{post},
            salary    = #{salary},
            hire_date = #{hireDate},
            status    = #{status}
        WHERE emp_id = #{empId}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM emp WHERE emp_id = #{empId}
    </delete>

    <!-- 动态条件查询：姓名模糊、部门精确等 -->
    <select id="selectByCondition" resultMap="empMap" parameterType="com.lab.entity.Emp">
        SELECT <include refid="allColumns"/>
        FROM emp
        <where>
            <if test="empName != null and empName != ''">
                AND emp_name LIKE CONCAT('%', #{empName}, '%')
            </if>
            <if test="dept != null and dept != ''">
                AND dept = #{dept}
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="post != null and post != ''">
                AND post = #{post}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY emp_id
    </select>

    <!-- 动态更新：只更新非空字段 -->
    <update id="updateDynamic" parameterType="com.lab.entity.Emp">
        UPDATE emp
        <set>
            <if test="empName != null and empName != ''">
                emp_name = #{empName},
            </if>
            <if test="gender != null and gender != ''">
                gender = #{gender},
            </if>
            <if test="dept != null and dept != ''">
                dept = #{dept},
            </if>
            <if test="post != null and post != ''">
                post = #{post},
            </if>
            <if test="salary != null">
                salary = #{salary},
            </if>
            <if test="hireDate != null">
                hire_date = #{hireDate},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        WHERE emp_id = #{empId}
    </update>

    <delete id="deleteBatch">
        DELETE FROM emp
        WHERE emp_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="empId" keyColumn="emp_id">
        INSERT INTO emp (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.empName}, #{e.gender}, #{e.dept}, #{e.post}, #{e.salary}, #{e.hireDate}, #{e.status})
        </foreach>
    </insert>

    <!-- choose：有 empName 精确匹配优先，否则有 dept 按部门，否则查全部 -->
    <select id="selectByChoose" resultMap="empMap" parameterType="com.lab.entity.Emp">
        SELECT <include refid="allColumns"/>
        FROM emp
        <where>
            <choose>
                <when test="empName != null and empName != ''">
                    emp_name = #{empName}
                </when>
                <when test="dept != null and dept != ''">
                    dept = #{dept}
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
        ORDER BY emp_id
    </select>

</mapper>
